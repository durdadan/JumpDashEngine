[locale]

translations=PoolStringArray(  )
translation_remaps={
"res://assets/fonts/small_font.tres": PoolStringArray( "res://assets/fonts/small_font_ja.tres:ja" ),
"res://assets/images/backgrounds/cut_scenes/title_screen/megaman_logo_fade_in.png": PoolStringArray( "res://assets/images/backgrounds/cut_scenes/title_screen/rockman_w.png:ja" ),
"res://scenes/themes/MegaManTheme.tres": PoolStringArray( "res://scenes/themes/MegaManTheme_jp.tres:ja" )
}

[memory]

limits/message_queue/max_size_kb=8192

[physics]

common/enable_pause_aware_picking=true

[rendering]

2d/snapping/use_gpu_pixel_snap=true
environment/default_environment="res://default_env.tres"
