; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node",
"class": "InputHandler",
"language": "GDScript",
"path": "res://globals/input_handler.gd"
}, {
"base": "KinematicBody2D",
"class": "LadderController",
"language": "GDScript",
"path": "res://scenes/players/ladder_controller/ladder_controller.gd"
}, {
"base": "KinematicBody2D",
"class": "Pickup",
"language": "GDScript",
"path": "res://scenes/pickups/pickup_class.gd"
}, {
"base": "KinematicBody2D",
"class": "Player",
"language": "GDScript",
"path": "res://scenes/players/Mega Man/scripts/mega_man.gd"
}, {
"base": "Timer",
"class": "PreciseTimer",
"language": "GDScript",
"path": "res://scenes/common/PreciseTimer.gd"
}, {
"base": "VisibilityNotifier2D",
"class": "PreciseVisibilityNotifier2D",
"language": "GDScript",
"path": "res://scenes/common/PreciseNotifier2D.gd"
}, {
"base": "Node2D",
"class": "Section",
"language": "GDScript",
"path": "res://scenes/stages/assets/section/section.gd"
}, {
"base": "Node",
"class": "Stage",
"language": "GDScript",
"path": "res://globals/stages.gd"
}, {
"base": "Node",
"class": "StageMusic",
"language": "GDScript",
"path": "res://globals/stage_music.gd"
}, {
"base": "Node",
"class": "State",
"language": "GDScript",
"path": "res://globals/state.gd"
}, {
"base": "Node",
"class": "StateMachine",
"language": "GDScript",
"path": "res://globals/state_machine.gd"
}, {
"base": "TileMap",
"class": "TileMapExtended",
"language": "GDScript",
"path": "res://globals/tile_map.gd"
}, {
"base": "Node2D",
"class": "YokuBlock",
"language": "GDScript",
"path": "res://scenes/stages/assets/Yoku/yoku_block.gd"
} ]
_global_script_class_icons={
"InputHandler": "",
"LadderController": "",
"Pickup": "",
"Player": "",
"PreciseTimer": "",
"PreciseVisibilityNotifier2D": "",
"Section": "",
"Stage": "",
"StageMusic": "",
"State": "",
"StateMachine": "",
"TileMapExtended": "",
"YokuBlock": ""
}

[application]

config/name="JumpDashEngine"
config/description="Blank Slate Engine to play with mega man"
run/main_scene="res://scenes/menus/logo_splash_screen/logo_splash_screen.tscn"
config/use_custom_user_dir=true
boot_splash/show_image=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
config/is_demo=false
config/version="0.0.0"
config/controller_mappings="cntrl"
config/config="opt"
config/statistics="player"
config/time_trial="timetrials"
config/save_file_extention=".w"

[autoload]

Physics="*res://globals/physics.gd"
Config="*res://globals/config.gd"
PlayerValues="*res://globals/player_values.gd"
Bitmask="*res://globals/Bitmask.gd"
Score="*res://globals/score_values.gd"
LevelValues="*res://globals/LevelValues.gd"

[debug]

gdscript/warnings/enable=false
gdscript/warnings/exclude_addons=false
gdscript/warnings/unused_argument=false
gdscript/warnings/narrowing_conversion=false
gdscript/warnings/unused_signal=false
gdscript/warnings/return_value_discarded=false

[display]

window/size/width=256
window/size/height=224
window/size/resizable=false
window/dpi/allow_hidpi=true
window/vsync/vsync_via_compositor=true
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[editor]

scene_naming=2

[editor_plugins]

enabled=PoolStringArray( "res://addons/Todo_Manager/plugin.cfg" )

[global]

res=false
preset=false
clear=false
vsync=false
shader=false
is_demo=false

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom="res://scenes/themes/MegaManTheme.tres"

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": false,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}
ogg_vorbis={
"loop": false,
"loop_offset": 0
}

